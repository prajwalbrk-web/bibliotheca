rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function lib(lid) { return get(/databases/$(database)/documents/libraries/$(lid)).data; }

    // One document per library: who owns it, who is a member, and who is invited.
    match /libraries/{lid} {
      allow read: if signedIn() && (
        request.auth.uid in resource.data.memberIds ||
        request.auth.token.email in resource.data.inviteEmails);

      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.members[request.auth.uid] == 'owner';

      allow update: if signedIn() && (
        // the owner can change anything (rename, invite, change access, remove people)
        resource.data.ownerId == request.auth.uid
        ||
        // an invited person can accept: it only adds themselves, with the access they were offered
        ( request.auth.token.email in resource.data.inviteEmails
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberIds', 'memberNames', 'inviteEmails', 'invites'])
          && request.auth.uid in request.resource.data.memberIds
          && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
          && request.resource.data.members[request.auth.uid]
               == resource.data.invites[request.auth.token.email.replace('[.]', ',')]
          && !(request.auth.token.email in request.resource.data.inviteEmails) )
        ||
        // a member (not the owner) can leave
        ( request.auth.uid in resource.data.memberIds
          && resource.data.ownerId != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['members', 'memberIds', 'memberNames'])
          && !(request.auth.uid in request.resource.data.memberIds) )
      );

      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // The books of a library: members can read, owners and editors can write.
    match /libraries/{lid}/books/{bid} {
      allow read: if signedIn() && request.auth.uid in lib(lid).memberIds;
      allow write: if signedIn() && lib(lid).members[request.auth.uid] in ['owner', 'editor'];
    }
  }
}
